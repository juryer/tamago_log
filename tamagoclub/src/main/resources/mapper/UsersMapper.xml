<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.UsersRepository">
	<insert id="insert" parameterType="com.example.demo.entity.Users">
		INSERT INTO users(
			username,
			password
		)VALUES(
			#{username},
			#{password}
		)
	
	</insert>
	
	<select id="findByUsername" resultType="com.example.demo.entity.Users">
    SELECT * FROM users WHERE username = #{username}
</select>

<select id="findById" resultType="com.example.demo.entity.Users">
    SELECT * FROM users WHERE id = #{id}
</select>

</mapper>