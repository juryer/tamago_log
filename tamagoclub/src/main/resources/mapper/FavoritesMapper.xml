<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.FavoritesMapper">

    <insert id="insert" parameterType="com.example.demo.entity.Favorites">
        INSERT INTO favorites(user_id, recipe_id)
        VALUES(#{userId}, #{recipeId})
    </insert>

    <delete id="delete">
        DELETE FROM favorites
        WHERE user_id = #{userId} AND recipe_id = #{recipeId}
    </delete>

    <select id="findByUserId" resultType="com.example.demo.entity.Favorites">
        SELECT * FROM favorites WHERE user_id = #{userId}
    </select>

    <select id="findByUserIdAndRecipeId" resultType="com.example.demo.entity.Favorites">
        SELECT * FROM favorites
        WHERE user_id = #{userId} AND recipe_id = #{recipeId}
    </select>

</mapper>
